<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tomas.session-radar</string>
    <!-- Every 15 min, 09:00-23:45 system time: full radar on the hour,
         cheap rename-only pass at :15/:30/:45. The shell guard also blocks
         wake-from-sleep catch-up runs inside the 00:00-08:30 quiet window
         (catch-up runs land on arbitrary minutes and thus do rename-only). -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>if [ "$(date +%H%M)" -ge 0830 ]; then if [ "$(date +%M)" = "00" ]; then exec /opt/homebrew/bin/uv run python /Users/tomas/claude/session-radar/session_radar.py > /dev/null; else exec /opt/homebrew/bin/uv run python /Users/tomas/claude/session-radar/session_radar.py --rename-only; fi; else echo "$(date): skipped (quiet hours)"; fi</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/Users/tomas/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
